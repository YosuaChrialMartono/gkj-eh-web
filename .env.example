# Phase 0 template. Keep real credentials in an untracked .env.local file.

# Current Nest bridge; remove this variable during Phase 7.
API_URL=http://localhost:8080

# Target consolidated application settings.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gkj_eh_web
AUTH_SECRET=replace-with-a-long-random-value
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
UPLOAD_DIR=/var/lib/gkj-eh-web/uploads

# Used by the current Google login UI until the Auth.js migration lands.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
